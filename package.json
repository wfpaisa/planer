{
  "name": "plane",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "setup": "bun install && bun run pocketbase:get && bun run env:init && bun run dev",
    "full:clean": "bun run scripts/full-clean.ts",
    "pocketbase:get": "bun run scripts/get-pocketbase.ts",
    "env:init": "cp -n .env.example .env || true",
    "dev": "bun run scripts/dev.ts",
    "build": "bun run --cwd web vite build",
    "start": "NODE_ENV=production bun run server/index.ts",
    "server": "bun --watch server/index.ts",
    "demo": "bun run scripts/demo.ts",
    "docs": "bun run scripts/docs.ts",
    "iconos:subconjunto": "bun run scripts/iconos-subconjunto.ts",
    "harness": "bun run scripts/harness-estilos.ts",
    "tablas:huerfanas": "bun run scripts/tablas-huerfanas.ts",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:relaciones": "bun run scripts/smoke-relaciones.ts",
    "smoke:permisos": "bun run scripts/smoke-permisos.ts",
    "smoke:ia": "bun run scripts/smoke-ia-conversacion.ts",
    "smoke:transferir": "bun run scripts/smoke-transferir.ts",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./web/tsconfig.json --threshold error",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "prettier --check . && eslint .",
    "check:fix": "prettier --write . && eslint . --fix",
    "prepare": "husky"
  },
  "trustedDependencies": [
    "husky"
  ],
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,ts,svelte}": "eslint --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "chart.js": "^4.5.1",
    "fflate": "^0.8.3",
    "monaco-editor": "^0.56.0",
    "pocketbase": "^0.26.2",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6",
    "@types/bun": "^1.3.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.9"
  }
}
