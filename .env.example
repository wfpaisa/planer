# Puerto del servidor (panel + apps publicadas)
PORT=3000

# PocketBase (se arranca automaticamente como proceso hijo)
PB_PORT=8090
PB_URL=http://127.0.0.1:8090

# Cuenta de administrador de PocketBase.
# Se crea sola la primera vez. Cambia la clave antes de usar en produccion.
PB_ADMIN_EMAIL=admin@planer.local
PB_ADMIN_PASSWORD=planer-admin-1234

# Prefijo privado hacia PocketBase entero (consola incluida). Vacio o sin
# definir: no se monta, y desde fuera no hay forma de llegar a la consola.
# En un servidor, generalo al azar y ponlo solo en `.env.docker`, nunca aqui:
#   openssl rand -hex 16
# Se llega entonces a la consola en  http://tu-servidor/<ese-valor>/_/
PB_ADMIN_PATH=

# Hay un proxy inverso delante (nginx, Caddy, Cloudflare). Decide de quien se
# cree que es cada peticion, que es lo que reparte el tope de intentos de la
# puerta de entrada: con proxy delante manda la cabecera que el trae; sin el,
# la cabecera la escribe quien llama y se descarta.
# Ponlo a 1 SOLO si de verdad hay un proxy inverso delante: encenderlo sin el
# deja que cualquiera estrene cupo en cada intento.
TRUSTED_PROXY=

# Puerto del servidor de desarrollo (solo con `bun run dev`)
WEB_PORT=5173
