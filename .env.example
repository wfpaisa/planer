# Puerto del servidor (panel + apps publicadas)
PORT=3000

# PocketBase (se arranca automaticamente como proceso hijo)
PB_PORT=8090
PB_URL=http://127.0.0.1:8090

# Cuenta de administrador de PocketBase.
# Se crea sola la primera vez. Cambia la clave antes de usar en produccion.
PB_ADMIN_EMAIL=admin@planer.local
PB_ADMIN_PASSWORD=planer-admin-1234

# Puerto del servidor de desarrollo (solo con `bun run dev`)
WEB_PORT=5173
