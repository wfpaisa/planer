# Lo que recibe el contenedor. Copia este archivo a `.env.docker` y cambia
# la clave antes de desplegar: es la cuenta de administrador de PocketBase y
# tambien la primera cuenta de constructor.
#
# Se reescribe en cada arranque del contenedor, asi que cambiarla aqui y
# reiniciar es tambien la forma de recuperarla si se pierde.
PB_ADMIN_EMAIL=admin@planer.local
PB_ADMIN_PASSWORD=planer-admin-1234

# Prefijo privado hacia PocketBase entero (consola incluida). Vacio o sin
# definir: no se monta, y desde fuera no hay forma de llegar a la consola.
# En un servidor, generalo al azar y ponlo solo en `.env.docker`, nunca aqui:
#   openssl rand -hex 16
# Se llega entonces a la consola en  http://tu-servidor/<ese-valor>/_/
PB_ADMIN_PATH=db
